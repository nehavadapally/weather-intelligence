# Local development only. Never commit a real Lakebase password.
LAKEBASE_URL=postgresql://<role>:<password>@<host>:5432/databricks_postgres?sslmode=require

# Environment Agency API: free, no API key required.
EA_FLOOD_API_BASE_URL=https://environment.data.gov.uk/flood-monitoring
WEATHER_USER_AGENT=databricks-weather-intelligence-homework/1.0
WEATHER_HTTP_TIMEOUT=30

WEATHER_DOCUMENTS_TABLE_NAME=weather_documents
WEATHER_EMBEDDINGS_TABLE_NAME=weather_embeddings
WEATHER_LOCATIONS=all
WEATHER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8000
FLASK_DEBUG=false
